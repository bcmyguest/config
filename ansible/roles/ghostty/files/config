# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# =============================================================================
# Tilix-matching keybindings
# Mapping: Tilix "session" = Ghostty tab, Tilix "terminal" = Ghostty split.
# Only bindings that differ from Ghostty's defaults, or need overriding, are
# listed here; ones that already match Ghostty defaults are noted in comments.
# =============================================================================

# NOTE: Ghostty has NO trailing comments — everything after `=` is the value,
# so a `# ...` on a keybind line is folded into the value and the bind is
# silently dropped. Keep every comment on its own line.

# --- Application / tabs (Tilix "sessions") ---
# app-new-session (matches default)
keybind = ctrl+shift+t=new_tab
# app-new-window (matches default)
keybind = ctrl+shift+n=new_window
# session-close (override: Ghostty default is quit)
keybind = ctrl+shift+q=close_tab:this
# win-switch-to-next/previous-session (match default)
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
# win-reorder-next/previous-session (override)
keybind = ctrl+shift+page_down=move_tab:1
keybind = ctrl+shift+page_up=move_tab:-1
# win-switch-to-session-1..9
keybind = ctrl+alt+1=goto_tab:1
keybind = ctrl+alt+2=goto_tab:2
keybind = ctrl+alt+3=goto_tab:3
keybind = ctrl+alt+4=goto_tab:4
keybind = ctrl+alt+5=goto_tab:5
keybind = ctrl+alt+6=goto_tab:6
keybind = ctrl+alt+7=goto_tab:7
keybind = ctrl+alt+8=goto_tab:8
keybind = ctrl+alt+9=goto_tab:9

# --- Splits (Tilix "terminals" within a session) ---
# session-add-right / -down / -auto
keybind = ctrl+alt+r=new_split:right
keybind = ctrl+alt+d=new_split:down
keybind = ctrl+alt+a=new_split:auto
# terminal-close (override: Ghostty default is close_tab)
keybind = ctrl+shift+w=close_surface
# terminal-maximize
keybind = ctrl+shift+x=toggle_split_zoom

# Focus splits — Alt+hjkl, vim-style (Tilix session-switch-to-terminal-*)
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
# session-switch-to-next/previous-terminal (override)
keybind = ctrl+tab=goto_split:next
keybind = ctrl+shift+tab=goto_split:previous

# Resize splits — Shift+Alt+Arrow (Tilix session-resize-terminal-*)
keybind = shift+alt+arrow_left=resize_split:left,10
keybind = shift+alt+arrow_right=resize_split:right,10
keybind = shift+alt+arrow_up=resize_split:up,10
keybind = shift+alt+arrow_down=resize_split:down,10

# --- Clipboard / selection (all match Ghostty defaults) ---
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection
keybind = ctrl+shift+a=select_all

# --- Font zoom ---
# terminal-zoom-in / -out
keybind = ctrl++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
# terminal-zoom-normal (matches default)
keybind = ctrl+0=reset_font_size

# --- Scrolling ---
# terminal-page-up / -down (match default)
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
# terminal-scroll-up / -down (one line)
keybind = ctrl+shift+up=scroll_page_lines:-1
keybind = ctrl+shift+down=scroll_page_lines:1

# --- Window ---
# win-fullscreen
keybind = f11=toggle_fullscreen
